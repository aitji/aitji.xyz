---
import Layout from "../layouts/Layout.astro";
import Discord from "../components/Discord";
import Clock from "../components/Clock";
import Projects from "../components/Projects";
import { friends } from "../data/friends";

const socials = [
  {
    label: "me",
    url: "mailto:me@aitji.com",
    icon: "material-symbols:alternate-email",
  },
  {
    label: "github",
    url: "https://github.com/aitji",
    icon: "mdi:github",
  },
  {
    label: "curseforge",
    url: "https://www.curseforge.com/members/aitji/projects",
    icon: "simple-icons:curseforge",
  },
  {
    label: "youtube",
    url: "https://www.youtube.com/@aitji-gamer",
    icon: "mdi:youtube",
  },
  {
    label: "discord",
    url: "https://aitji.xyz/discord",
    icon: "ic:baseline-discord",
  },
  {
    label: "x",
    url: "https://x.com/aitji_",
    icon: "ri:twitter-x-fill",
  },
  {
    label: "reddit",
    url: "https://reddit.com/u/aitji",
    icon: "basil:reddit-solid",
  },
];
---

<Layout>
  <main class="page">
    <!-- hero -->
    <section class="hero container">
      <div class="hero-name-row">
        <h1 class="hero-name">aitji</h1>
      </div>
      <div class="hero-meta">
        <Discord client:load />
        <span class="meta-sep" aria-hidden="true">·</span>
        <Clock client:load />
        <span class="meta-tz muted">gmt+7</span>
      </div>
      <p class="hero-sub">
        self-taught developer &amp; (sort of) full-stack web dev.
        <br class="br-hide" />i use lowercase letters.
      </p>
    </section>

    <div class="divider container" aria-hidden="true"></div>

    <!-- about -->
    <section class="section container" id="about">
      <p class="section-label">about</p>
      <div class="card">
        <p>
          hey, i'm <strong>aitji</strong> a developer who builds things. i like making
          stuff. currently figuring out what to do with this domain.
        </p>
        <div class="tag-row">
          <span class="tag">astro</span>
          <span class="tag">solidjs</span>
          <span class="tag">tailwind</span>
          <span class="tag">vite</span>
          <span class="tag">typescript</span>
          <span class="tag">javascript</span>
          <span class="tag">vercel</span>
          <span class="tag">cloudflare</span>
        </div>
      </div>
    </section>

    <!-- links -->
    <section class="section container" id="links">
      <p class="section-label">links</p>
      <div class="socials-row">
        {
          socials.map((s) => (
            <a
              href={s.url}
              class="social-btn"
              target={s.url.startsWith("mailto") ? undefined : "_blank"}
              rel="noopener noreferrer"
            >
              <iconify-icon
                icon={s.icon}
                width="15"
                height="15"
                aria-hidden="true"
              />
              <span>{s.label}</span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- projects -->
    <section class="section container" id="projects">
      <p class="section-label">projects</p>
      <Projects client:load />
    </section>

    <!-- friends -->
    {
      friends.length > 0 && (
        <section class="section container" id="friends">
          <p class="section-label">friends</p>
          <div class="friends-grid">
            {friends.map((f) => {
              let icon
              if (f.url) {
                icon = "gridicons:domains"
                if (f.url.startsWith("https://github.com/")) icon = "mdi:github"
              }
              const Tag = f?.url ? "a" : "span"

              return (
                <Tag
                  href={f.url}
                  title={f.url}
                  class="friend-card"
                  target={f.url ? "_blank" : undefined}
                  rel={f.url ? "noopener noreferrer" : undefined}
                >
                  <span class="friend-name">{f.name}</span>
                  <span class="friend-desc muted">{f.desc}</span>
                  {icon && (
                    <span class="friend-url muted">
                      <iconify-icon
                        icon={icon}
                        width="15"
                        height="15"
                        aria-hidden="true"
                      />
                    </span>
                  )}
                </Tag>
              );
            })}
          </div>
        </section>
      )
    }

    <!-- footers -->
    <footer class="footer container">
      <div class="footer-inner">
        <p class="footer-txt muted">
          <a href="https://aitji.xyz">aitji.xyz</a> · built with
          <a href="https://astro.build" target="_blank">astro</a> +
          <a href="https://solidjs.com" target="_blank">solidjs</a>
        </p>
        <a href="mailto:me@aitji.com" class="badge-88x31">@me</a>
      </div>
    </footer>
  </main>
</Layout>

<style>
  @import "../styles/pages/home.css";
</style>
