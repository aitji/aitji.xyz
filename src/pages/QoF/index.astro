---
import Layout from "../../layouts/Layout.astro";

interface ReleaseNote {
    text: string;
    link?: { label: string; href: string };
    faded?: boolean;
}

interface Release {
    id: string;
    name: string;
    version: string;
    featured: boolean;
    tag?: string;
    sub?: string;
    notes: ReleaseNote[];
}

const releases: Release[] = [
    {
        id: "v1-5-0",
        name: "WELL EQUIPPED",
        version: "1.5.0",
        featured: true,
        tag: "latest",
        notes: [
            {
                text: "A full wiki is now available on GitHub. You can explore it here",
                link: {
                    label: 'QoF v1.5.0\'s "Well Equipped" Update',
                    href: "https://github.com/aitji/QoF/wiki",
                },
            },
            {
                text: "The project has been rewritten in TypeScript for better structure and maintainability.",
                faded: true,
            },
        ],
    },
    {
        id: "v1-4-1",
        name: "HOT FIXED",
        version: "1.4.1",
        featured: false,
        notes: [
            {
                text: "No need to update to this version yet. This change only introduces the rebranding.",
            },
            {
                text: "We are preparing for v1.5.0. You can follow the progress on the main branch (behavior packs (main), resource packs).",
                faded: true,
            },
        ],
    },
    {
        id: "v1-4-0",
        name: "SEAMLESS",
        version: "1.4.0",
        featured: true,
        sub: "(New) Double Door",
        notes: [
            {
                text: "Players can now interact with one door to instantly open the adjacent door.",
            },
            {
                text: "Works with all wooden door variants and supports both left- and right-handed configurations.",
                faded: true,
            },
        ],
    },
    {
        id: "v1-3-4",
        name: "HOT FIXED",
        version: "1.3.4",
        featured: false,
        notes: [
            {
                text: "While consuming food, a torch held in the offhand will no longer be placed.",
            },
            {
                text: "Dev Note Quick note before anything else - I found a workaround that significantly reduces the size of dynamic properties",
                faded: true,
            },
        ],
    },
    {
        id: "v1-3-3",
        name: "HOT FIXED",
        version: "1.3.3",
        featured: false,
        notes: [
            {
                text: "(NO_JUMP_HOLD_CHEST) now defaults to (false) (can still be enabled in the settings panel)",
            },
            {
                text: "Reduced the downward velocity applied while carrying a chest from (-0.02) to (-0.008) per tick",
                faded: true,
            },
        ],
    },
    {
        id: "v1-3-2",
        name: "HOT FIXED",
        version: "1.3.2",
        featured: false,
        notes: [
            {
                text: "Torches no longer be placed on (qof:light_block)",
            },
            {
                text: "Faster startup time due to improved (_restoreFromDYP) restoration logic",
                faded: true,
            },
        ],
    },
    {
        id: "v1-3-1",
        name: "HOT FIXED",
        version: "1.3.1",
        featured: false,
        notes: [
            {
                text: "(javascript) and (json) files are now automatically minified before release to reduce file size",
            },
            {
                text: "(_notes.md) added to the root directory of both (behavior_packs) and (resource_packs)",
                faded: true,
            },
        ],
    },
    {
        id: "v1-3-0",
        name: "IN SYNC",
        version: "1.3.1",
        featured: true,
        notes: [
            {
                text: "Update base game version to ",
                link: {
                    label: "26.10 Tiny-Takeover",
                    href: "https://feedback.minecraft.net/hc/en-us/articles/44418129038733-Minecraft-Bedrock-Edition-26-10-Tiny-Takeover",
                },
            },
            {
                text: "Update Script API to ",
                link: {
                    label: "2.7.0@beta",
                    href: "https://www.npmjs.com/package/@minecraft/server/v/2.7.0-beta.1.26.10-stable",
                },
                faded: true,
            },
        ],
    },
    {
        id: "v1-2-3",
        name: "HOT FIXED",
        version: "1.2.3",
        featured: false,
        notes: [
            {
                text: "Re-branding from QoL (Quality of Life) to QoF (Quality of Feature)",
            },
            {
                text: "No need to update to this version yet. This change only introduces the rebranding. We are preparing for v1.3.0.",
                faded: true,
            },
        ],
    },
    {
        id: "v1-2-2",
        name: "HOT FIXED",
        version: "1.2.2",
        featured: false,
        notes: [
            {
                text: "Add mob loot to previously unlootable mobs",
            },
            {
                text: "1. Sniffer Drop Moss Block",
                faded: true,
            },
        ],
    },
    {
        id: "v1-2-1",
        name: "HOT FIXED",
        version: "1.2.1",
        featured: false,
        notes: [
            {
                text: "Wrapped (debug message) on startup to DEBUG mode",
            },
            {
                text: "Removed (debug message) from Dynamic Light",
                faded: true,
            },
        ],
    },
    {
        id: "v1-2-0",
        name: "TAKE CONTROL",
        version: "1.2.0",
        featured: true,
        notes: [
            {
                text: "We migrated the (manifest.json) from (format_version 2) to (format_version 3).",
            },
            {
                text: "This gives us access to pack settings, which is an in-game pack configuration system",
                faded: true,
            },
        ],
    },
    {
        id: "v1-1-1",
        name: "HOT FIXED",
        version: "1.1.1",
        featured: false,
        notes: [
            {
                text: "(scripts/_config.js) now heavily uses (Object.freeze(...))",
            },
            {
                text: "Add (qof:chest) entity to temporarily store container",
                faded: true,
            },
        ],
    },
    {
        id: "v1-1-0",
        name: "SUBTLE SHIFT",
        version: "1.1.0",
        featured: true,
        notes: [
            {
                text: "(Dev Note): This is a first release of Quality of Feature, hope you enjoy!",
            },
            {
                text: "Move from pure Dynamic Property and (Set()) to get more performance, following (light, frame, chunk_unload)",
                faded: true,
            },
        ],
    },
];

const hasFaded = (notes: (typeof releases)[0]["notes"]) =>
    notes.some((n) => n.faded);
---

<Layout
    title="QoF, Quality of Feature"
    description="A Minecraft Bedrock addon that adds small vanilla-friendly features. Each module is configurable through the in-game pack settings panel."
>
    <!-- back to main site? -->
    <!-- <a href="/" class="qof-back">aitji.xyz</a> -->

    <!-- modal -->
    <div
        class="qof-modal-overlay"
        id="modal-overlay"
        role="dialog"
        aria-modal="true"
        aria-hidden="true"
    >
        <div class="qof-modal" id="qof-modal">
            <div class="modal-header">
                <div class="modal-title-row">
                    <span class="modal-name" id="modal-name"></span>
                    <span class="modal-version" id="modal-version"></span>
                </div>
                <button
                    class="modal-close"
                    id="modal-close"
                    aria-label="Close modal">×</button
                >
            </div>
            <div class="modal-body" id="modal-body"></div>
        </div>
    </div>

    <!-- page -->
    <div class="qof-page">
        <div class="qof-split" id="qof-split">
            <!-- LEFT: hero -->
            <aside class="qof-hero">
                <div class="hero-shrink-wrapper">
                    <div class="hero-inner">
                        <div class="hero-logo-row">
                            <img
                                src="/QoF/pack_icon.png"
                                alt="QoF pack icon"
                                class="pack-icon"
                                width="60"
                                height="60"
                            />
                            <span class="qof-wordmark">QoF</span>
                        </div>

                        <h1 class="qof-fullname">
                            Quality&nbsp;of&nbsp;Feature
                        </h1>

                        <p class="qof-desc">
                            A Minecraft Bedrock addon that adds small
                            vanilla-friendly features. Each module is
                            configurable through the in-game pack settings
                            panel.
                        </p>
                        <p class="qof-note">
                            * Requires BetaAPIs enabled under Experiments.
                        </p>

                        <div class="hero-actions">
                            <a href="#" class="qof-btn download">download</a>
                            <a href="#" class="qof-btn">beta</a>
                            <a
                                href="https://github.com/aitji/QoF"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="qof-btn pc-only"
                            >
                                <iconify-icon
                                    icon="mdi:github"
                                    width="14"
                                    height="14"
                                    aria-hidden="true"></iconify-icon>
                                github
                            </a>
                        </div>

                        <!-- mobile-only -->
                        <p class="mobile-avail">
                            QoF (Quality Of Feature) also available at&nbsp;
                            <a
                                href="https://www.curseforge.com/minecraft-bedrock/addons/quality-of-feature"
                                target="_blank"
                                rel="noopener noreferrer">CurseForge</a
                            >,&nbsp;
                            <a
                                href="https://mcpedl.com/quality-of-feature"
                                target="_blank"
                                rel="noopener noreferrer">MCPEDL</a
                            >&nbsp;and&nbsp;
                            <a
                                href="https://github.com/aitji/QoF"
                                target="_blank"
                                rel="noopener noreferrer">GitHub</a
                            >
                        </p>

                        <!-- hint -->
                        <div class="scroll-hint" aria-hidden="true">
                            <button class="scroll-hint-btn" id="scroll-hint-btn"
                                >v</button
                            >
                        </div>
                    </div><!-- /.hero-inner -->

                    <!-- footer for pc -->
                    <footer class="qof-footer">
                        <div class="qof-footer-inner">
                            <div class="qof-credits">
                                <a
                                    href="https://github.com/aitji"
                                    target="_blank"
                                    ><img
                                        src="/QoF/aitji.png"
                                        alt="aitji"
                                        class="credit-avatar"
                                        width="28"
                                        height="28"
                                        title="aitji"
                                    /></a
                                >
                                <a
                                    href="https://github.com/pickerth-12"
                                    target="_blank"
                                    ><img
                                        src="/QoF/pickerth-12.png"
                                        alt="pickerth-12"
                                        class="credit-avatar"
                                        width="28"
                                        height="28"
                                        title="pickerth-12"
                                    /></a
                                >
                            </div>
                            <p class="qof-copyright">
                                Copyright (c) 2026 aitji &amp; pickerth-12
                                &mdash; MIT License
                            </p>
                        </div>
                    </footer>
                </div><!-- /.hero-shrink-wrapper -->

                <!-- collapse -->
                <button
                    class="collapse-btn"
                    id="collapse-btn"
                    aria-label="Toggle hero panel"
                    aria-expanded="true"
                >
                    <span id="collapse-icon">&lt;</span>
                </button>
            </aside><!-- /.qof-hero -->

            <!-- RIGHT: changelog -->
            <section
                class="qof-changelog"
                id="qof-changelog"
                aria-label="Changelog"
            >
                {
                    releases.map((r) => (
                        <article class="version-entry" id={r.id}>
                            <div class="version-header">
                                <h2
                                    class={`version-name${!r.featured ? " muted-name" : ""}`}
                                >
                                    {r.name}
                                </h2>
                                <span class="version-num">{r.version}</span>
                                {r.tag && (
                                    <span class="version-tag">{r.tag}</span>
                                )}
                            </div>

                            {r.sub && <p class="version-sub">{r.sub}</p>}

                            <ul
                                class={`version-notes${hasFaded(r.notes) ? " clipped" : ""}`}
                            >
                                {r.notes.map((n) => (
                                    <li>
                                        <span>
                                            {n.text}
                                            {n.link && (
                                                <>
                                                    {" "}
                                                    <a
                                                        href={n.link.href}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                    >
                                                        {n.link.label}
                                                    </a>
                                                </>
                                            )}
                                        </span>
                                    </li>
                                ))}
                            </ul>

                            <div class="version-actions">
                                <a
                                    data-release-id={r.version}
                                    class="linkto qof-btn download"
                                >
                                    download
                                </a>
                                <button
                                    class="linkto qof-btn read-more"
                                    data-release-id={r.version}
                                    type="button"
                                >
                                    read more
                                </button>
                            </div>
                        </article>
                    ))
                }
            </section><!-- /.qof-changelog -->
        </div><!-- /.qof-split -->
    </div><!-- /.qof-page -->

    <!-- pass release data to client -->
    <script define:vars={{ releases }}>
        // collapse
        const split = document.getElementById("qof-split");
        const collapseBtn = document.getElementById("collapse-btn");
        const collapseIcon = document.getElementById("collapse-icon");

        collapseBtn?.addEventListener("click", () => {
            const isNowFull = split?.classList.toggle("fullscreen");
            if (collapseIcon) collapseIcon.textContent = isNowFull ? ">" : "<";
            collapseBtn.setAttribute(
                "aria-expanded",
                isNowFull ? "false" : "true",
            );
        });

        // modal
        // const overlay = document.getElementById("modal-overlay");
        // const modalName = document.getElementById("modal-name");
        // const modalVer = document.getElementById("modal-version");
        // const modalBody = document.getElementById("modal-body");
        // const modalClose = document.getElementById("modal-close");

        // const releasesMap = Object.fromEntries(releases.map((r) => [r.id, r]));

        // function openModal(releaseId) {
        //     const r = releasesMap[releaseId];
        //     if (!r || !overlay || !modalName || !modalVer || !modalBody) return;

        //     modalName.textContent = r.name;
        //     modalName.className = "modal-name" + (r.featured ? "" : " muted");
        //     modalVer.textContent = r.version;

        //     let html = "";
        //     if (r.sub) html += `<p class="modal-sub">${r.sub}</p>`;
        //     html += '<ul class="modal-notes">';
        //     for (const n of r.notes) {
        //         const link = n.link
        //             ? ` <a href="${n.link.href}" target="_blank" rel="noopener noreferrer">${n.link.label}</a>`
        //             : "";
        //         html += `<li><span>${n.text}${link}</span></li>`;
        //     }
        //     html += "</ul>";

        //     modalBody.innerHTML = html;
        //     overlay.classList.add("open");
        //     overlay.setAttribute("aria-hidden", "false");
        //     document.body.style.overflow = "hidden";
        // }

        // function closeModal() {
        //     overlay?.classList.remove("open");
        //     overlay?.setAttribute("aria-hidden", "true");
        //     document.body.style.overflow = "";
        // }

        // modalClose?.addEventListener("click", closeModal);
        // overlay?.addEventListener("click", (e) => {
        //     if (e.target === overlay) closeModal();
        // });
        // document.addEventListener("keydown", (e) => {
        //     if (e.key === "Escape") closeModal();
        // });

        document.querySelectorAll(".linkto[data-release-id]").forEach((btn) => {
            btn.addEventListener(
                "click",
                () => {
                    const version = btn.dataset.releaseId;
                    console.log(btn.className);
                    if (btn.className.includes("download"))
                        window.open(
                            `https://github.com/aitji/QoF/releases/download/v${version}/QoF-${version}.mcaddon`,
                        );
                    else
                        window.open(
                            `https://github.com/aitji/QoF/releases/tag/v${version}`,
                        );
                },
                // openModal(btn.dataset.releaseId),
            );
        });

        // scroll hint
        document
            .getElementById("scroll-hint-btn")
            ?.addEventListener("click", () => {
                document
                    .getElementById("qof-changelog")
                    ?.scrollIntoView({ behavior: "smooth" });
            });
    </script>

    <!-- footer for mobile -->
    <footer class="qof-footer mobile-only">
        <div class="qof-footer-inner">
            <div class="qof-credits">
                <a href="https://github.com/aitji" target="_blank"
                    ><img
                        src="/QoF/aitji.png"
                        alt="aitji"
                        class="credit-avatar"
                        width="28"
                        height="28"
                        title="aitji"
                    /></a
                >
                <a href="https://github.com/pickerth-12" target="_blank"
                    ><img
                        src="/QoF/pickerth-12.png"
                        alt="pickerth-12"
                        class="credit-avatar"
                        width="28"
                        height="28"
                        title="pickerth-12"
                    /></a
                >
            </div>
            <p class="qof-copyright">
                Copyright (c) 2026 aitji &amp; pickerth-12 &mdash; MIT License
            </p>
        </div>
    </footer>
</Layout>

<style>
    @import "../../styles/pages/qof.css";
</style>
